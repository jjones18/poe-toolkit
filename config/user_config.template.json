{
    "config_schema_version": 2,
    "_comment": "Copy this template to the per-user poe-toolkit config directory and fill in your settings",
    "_note": "Use the Settings page or the OS-specific paths documented in README.md; never commit live credentials",
    
    "app": {
        "active_game": "poe1"
    },
    "credentials": {
        "session_id": "YOUR_POESESSID_HERE",
        "account_name": "YOUR_ACCOUNT_NAME"
    },
    "game_settings": {
        "poe1": {
            "league": "Settlers",
            "league_options": []
        },
        "poe2": {
            "league": "Standard",
            "league_options": []
        }
    },
    "overlay": {
        "x_offset": 18,
        "y_offset": 160,
        "cell_size": 53,
        "is_quad_calibrated": false
    },
    "window": {
        "x": 100,
        "y": 100,
        "width": 1100,
        "height": 800
    },
    "league_vision": {
        "client_log_path": "C:/Path/To/Your/PoE/logs/Client.txt",
        "_client_log_path_settings_note": "This is editable in the toolkit Settings page under Local Paths.",
        "_client_log_path_linux": "On Linux (Steam/Proton): ~/.steam/steam/steamapps/compatdata/<appid>/pfx/drive_c/users/steamuser/AppData/Local/Path of Exile/logs/Client.txt",
        "tesseract_path": "C:/Program Files/Tesseract-OCR/tesseract.exe",
        "_tesseract_path_linux": "On Linux: leave as 'tesseract' (install with: sudo apt install tesseract-ocr)",
        "map_device_button": {
            "x": 0,
            "y": 0,
            "w": 0,
            "h": 0
        },
        "resolution_override": {
            "enabled": false,
            "width": 1920,
            "height": 1080
        },
        "scan_region_hover": {
            "width": 700,
            "height": 800,
            "x_offset": -600,
            "x_offset_right": -100,
            "y_offset": -800
        }
    }
}
