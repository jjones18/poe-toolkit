{
    "config_schema_version": 3,
    "_comment": "Copy this template to the per-user poe-toolkit config directory and fill in your settings",
    "_note": "Use the Settings page or the OS-specific paths documented in README.md; never commit live credentials",
    
    "app": {
        "active_game": "poe1"
    },
    "credentials": {
        "session_id": "YOUR_POESESSID_HERE",
        "account_name": "YOUR_ACCOUNT_NAME"
    },
    "game_settings": {
        "poe1": {
            "league": "Settlers",
            "league_options": [],
            "client_log_path": "C:/Path/To/Path of Exile/logs/Client.txt"
        },
        "poe2": {
            "league": "Standard",
            "league_options": [],
            "client_log_path": "C:/Path/To/Path of Exile 2/logs/Client.txt"
        }
    },
    "trade_sniper": {
        "custom_allowed_zones": {
            "poe1": [],
            "poe2": []
        }
    },
    "crafting": {
        "poe1": {
            "mode": "links",
            "target": 5,
            "unlimited": true,
            "max_attempts": 1500,
            "apply_delay_ms": 80,
            "start_hotkey": "Numpad Plus",
            "stop_hotkey": "Numpad Minus"
        }
    },
    "overlay": {
        "x_offset": 18,
        "y_offset": 160,
        "cell_size": 53,
        "is_quad_calibrated": false
    },
    "window": {
        "x": 100,
        "y": 100,
        "width": 1100,
        "height": 800
    },
    "league_vision": {
        "tesseract_path": "C:/Program Files/Tesseract-OCR/tesseract.exe",
        "_tesseract_path_linux": "On Linux: leave as 'tesseract' (install with: sudo apt install tesseract-ocr)",
        "map_device_button": {
            "x": 0,
            "y": 0,
            "w": 0,
            "h": 0
        },
        "resolution_override": {
            "enabled": false,
            "width": 1920,
            "height": 1080
        },
        "scan_region_hover": {
            "width": 700,
            "height": 800,
            "x_offset": -600,
            "x_offset_right": -100,
            "y_offset": -800
        }
    }
}
